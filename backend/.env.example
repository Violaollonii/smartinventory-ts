# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep the database name in the path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartinventory?retryWrites=true&w=majority

# Secret used to sign JWTs. Must be at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# HTTP port for the API
PORT=3000

# Origin allowed by CORS (the Vite dev server)
FRONTEND_ORIGIN=http://localhost:5173

# Accounts created by `npm run seed` (only used by the seed script)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_STAFF_EMAIL=staff@example.com
SEED_STAFF_PASSWORD=replace-with-a-strong-password
